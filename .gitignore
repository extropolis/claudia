# Dependencies
# No trailing slash: in a git worktree `node_modules` is often a SYMLINK to the
# primary checkout's copy, and `node_modules/` only matches directories — so the
# symlink would show up as untracked and could be committed by `git add -A`.
node_modules

# pid file for the shared Playwright MCP server (see shared-mcp-manager.ts)
backend/.shared-playwright-mcp-*.pid
backend/.shared-playwright-mcp-*.log

# Build outputs
dist/
dist-electron/
build/
release/
*.tsbuildinfo

# Coverage reports
coverage/

# IDE
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Logs
*.log
server_log.txt
server_log_new.txt

# Test artifacts
*.png
!assets/icon.png
test-*.txt
clean_output.txt

# Temp files
hello.txt
hello_verify.txt
"hello world"

# Misc test files
fib.js
fib.test.js
hello.py
hello_world.py
helloworld.py
foobar.py
test123.py
calculator.js
script.js

# Local config
.env
.env.local
start.ps1
.claude/settings.local.json
.mcp.json

# Runtime data (persisted state) — never commit per-user data
backend/mcp-token
# Single-instance lock (backend/ is the legacy data directory)
backend/instance.json
backend/tasks.json
backend/tasks.json.bak
backend/tasks.json.*.tmp
backend/archived-tasks.json
backend/archived-tasks.json.bak
backend/archived-tasks.json.*.tmp
backend/checkpoints.json
backend/checkpoints.json.bak
backend/checkpoints.json.*.tmp
backend/session-recovery.json
backend/session-recovery.json.bak
backend/session-recovery.json.*.tmp
backend/learnings.json
backend/learnings.json.bak
backend/learnings.json.*.tmp
backend/scheduled-tasks.json
backend/config.json
backend/workspace-config.json
backend/chat-history.json
backend/todos.json
backend/archived-histories/
backend/task-histories/
backend/data/conversations.json

# Vite cache
vite

# Playwright MCP snapshots
.playwright-mcp/

# Claudia task worktrees (created at runtime by the orchestrator)
.claudia-worktrees/
# Playwright browser E2E
/playwright-report/
/test-results/
/blob-report/
/playwright/.cache/
# The E2E frontend bundle. Built with the sandbox backend port compiled in and
# kept OUT of frontend/dist, which is a real production artifact (served by the
# backend on the tunnel route, loaded by the packaged Electron app).
frontend/dist-e2e/
# Sandboxed E2E state. Normally lives at ~/.claudia-e2e-<port> (outside the
# repo), but ignored here too so a CLAUDIA_E2E_* override pointing inside the
# checkout can never be committed.
.claudia-e2e-*/
.claudia-e2e/
