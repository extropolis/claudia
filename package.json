{
  "name": "@extropolis/claudia",
  "productName": "Claudia",
  "version": "0.2.4",
  "description": "Multi-instance Claude Code orchestrator web UI",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/extropolis/claudia.git"
  },
  "homepage": "https://github.com/extropolis/claudia",
  "bugs": {
    "url": "https://github.com/extropolis/claudia/issues"
  },
  "keywords": [
    "claude",
    "claude-code",
    "orchestrator",
    "ai",
    "terminal",
    "electron"
  ],
  "type": "module",
  "main": "dist-electron/main.js",
  "bin": {
    "claudia": "bin/claudia.mjs"
  },
  "files": [
    "bin/",
    "backend/dist/",
    "backend/hooks/",
    "backend/package.json",
    "frontend/dist/",
    "frontend/package.json",
    "shared/dist/",
    "shared/package.json",
    "dist-electron/",
    "electron/",
    "start.sh",
    "start.ps1",
    "start-electron.sh",
    "start-electron.ps1",
    "install.sh",
    "install.ps1",
    "index.html",
    "styles.css",
    "version.txt",
    "README.md",
    "LICENSE"
  ],
  "workspaces": [
    "backend",
    "frontend",
    "shared"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "npm run dev -w backend",
    "dev:frontend": "npm run dev -w frontend",
    "dev:electron": "npm run build:backend && npm run build:electron && NODE_ENV=development electron .",
    "build": "npm run build:backend && npm run build:frontend && npm run build:electron",
    "build:backend": "npm run build -w backend",
    "build:frontend": "npm run build -w frontend",
    "build:electron": "tsc -p electron/tsconfig.json && tsc -p electron/tsconfig.preload.json",
    "package": "npm run build && electron-builder",
    "package:mac": "npm run build && electron-builder --mac",
    "package:win": "npm run build && electron-builder --win",
    "package:linux": "npm run build && electron-builder --linux",
    "prepare": "npm run build -w shared && npm run build:backend",
    "start": "./start-electron.sh",
    "test": "npm run test:backend && npm run test:frontend",
    "test:backend": "npm test -w backend",
    "test:frontend": "npm test -w frontend",
    "test:watch": "concurrently \"npm run test:watch -w backend\" \"npm run test:watch -w frontend\"",
    "version:sync": "node scripts/bump-version.mjs",
    "version:check": "node scripts/bump-version.mjs --check",
    "release": "node scripts/release.mjs"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "cross-env": "^10.1.0",
    "electron": "^39.2.7",
    "electron-builder": "^26.4.0",
    "playwright": "^1.57.0"
  },
  "bundleDependencies": [
    "@claudia/shared"
  ],
  "dependencies": {
    "@claudia/shared": "*",
    "@anthropic-ai/sdk": "^0.71.2",
    "@homebridge/node-pty-prebuilt-multiarch": "^0.12.0",
    "@llamaindex/anthropic": "^0.3.26",
    "@modelcontextprotocol/sdk": "^1.25.2",
    "@opencode-ai/sdk": "^1.1.14",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^4.18.2",
    "get-port": "^7.1.0",
    "jsonwebtoken": "^9.0.3",
    "llamaindex": "^0.12.1",
    "marked": "^15.0.12",
    "marked-terminal": "^7.3.0",
    "multer": "^2.0.2",
    "opencode-studio-server": "^1.2.1",
    "uuid": "^9.0.1",
    "ws": "^8.16.0"
  },
  "build": {
    "appId": "com.claudia.app",
    "productName": "Claudia",
    "directories": {
      "output": "release"
    },
    "asarUnpack": [
      "node_modules/@homebridge/node-pty-prebuilt-multiarch/**"
    ],
    "files": [
      "dist-electron/**/*",
      "frontend/dist/**/*",
      "backend/dist/**/*",
      "backend/hooks/**/*",
      "node_modules/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "backend/hooks",
        "to": "hooks",
        "filter": [
          "**/*"
        ]
      }
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.icns",
      "hardenedRuntime": true,
      "gatekeeperAssess": false
    },
    "dmg": {
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ],
      "window": {
        "width": 540,
        "height": 380
      }
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "assets/icon.ico"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Development",
      "icon": "assets/icon.png"
    }
  }
}
