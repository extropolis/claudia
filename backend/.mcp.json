{
  "mcpServers": {
    "playwright": {
      "command": "npx",
      "args": [
        "@playwright/mcp@latest",
        "--isolated"
      ]
    },
    "duckduckgo": {
      "command": "npx",
      "args": [
        "-y",
        "ddg-mcp-search"
      ]
    },
    "jira_mcp": {
      "type": "http",
      "url": "https://litellm.concur.click/mcp/jira_mcp",
      "timeout": 30
    },
    "claudia": {
      "command": "npx",
      "args": [
        "tsx",
        "/Users/I850333/projects/experiments/claudia/backend/src/claudia-mcp-server.ts"
      ]
    }
  }
}