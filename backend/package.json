{
  "name": "backend",
  "version": "0.2.30",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "cross-env CLAUDIA_WATCH_MODE=1 NODE_OPTIONS=--max-old-space-size=2048 tsx watch --watch-path=src src/index.ts",
    "dev:no-watch": "cross-env NODE_OPTIONS=--max-old-space-size=2048 tsx src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test:cli": "tsx test-cli.ts",
    "test:build": "npm run build && node dist/test-cli.js",
    "test": "npx vitest run",
    "test:watch": "npx vitest",
    "test:coverage": "npx vitest run --coverage"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.71.2",
    "@claudia/shared": "*",
    "@modelcontextprotocol/sdk": "^1.25.2",
    "@opencode-ai/sdk": "^1.1.14",
    "@types/multer": "^2.0.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.3",
    "marked": "^15.0.12",
    "marked-terminal": "^7.3.0",
    "multer": "^2.0.2",
    "node-pty": "^1.1.0",
    "uuid": "^9.0.1",
    "ws": "^8.16.0"
  },
  "devDependencies": {
    "@playwright/mcp": "^0.0.64",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.11.0",
    "@types/uuid": "^9.0.7",
    "@types/ws": "^8.5.10",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3",
    "vitest": "^3.1.4",
    "@vitest/coverage-v8": "^3.2.4"
  }
}
